# Server-only config. NEVER expose these to the browser. Set in Coolify env vars.
PORT=3000
# Gateway key (server-side only). Paste your private key here / in Coolify.
AI_GATEWAY_KEY=
# Optional overrides (defaults already work):
# MODEL_ID=
# GATEWAY_URL=
TOKEN_BUDGET=100000
NUM_CODES=100
DATA_PATH=/data/data.json
# To use a fixed set of 100 codes: comma-separated list. If empty, random codes are generated on first boot.
# ACCESS_CODES=USSR-AAAA-BBBB,USSR-CCCC-DDDD,...
SYSTEM_PROMPT=You are USSR GPT, a helpful assistant. Be concise, practical, and friendly.
