# Server-only config. NEVER expose these to the browser.
PORT=3000

# PROVIDER: how the site answers.
#   openrouter = same key system as your local setup, site runs on localhost (needs internet)
#   ollama     = fully offline, no key needed (needs `ollama pull <model>` first)
#   gateway    = hosted backend (used for the Coolify deploy)
PROVIDER=openrouter

# Key for openrouter/gateway (server-side only). Your existing local key works.
# AI_GATEWAY_KEY=...
# OPENROUTER_API_KEY=...

# Pick any model id from your provider. Free-tier example default:
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Fully-offline example:
# PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
# OLLAMA_URL=http://localhost:11434/v1/chat/completions

TOKEN_BUDGET=100000
NUM_CODES=100
DATA_PATH=./data.json
# Fixed codes (comma-separated). If empty, random codes on first boot.
# ACCESS_CODES=USSR-AAAA-BBBB,USSR-CCCC-DDDD,...
SYSTEM_PROMPT=You are USSR GPT, a helpful assistant. Be concise, practical, and friendly.
